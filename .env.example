# Seriales válidos (lista fija + demo)
VALID_SERIALS=DEMO-SERIAL-2026,MBX-ALPHA-001

# Secreto compartido con Serial Admin (firma de seriales MBX-…)
SERIAL_SECRET=monetixa-change-me-pro-2026

# Wallets de depósito manual (fallback si el token no tiene depositWallet)
DEPOSIT_ETH=
DEPOSIT_BSC=
DEPOSIT_SOL=

# Notificación por correo al confirmar TXN
NOTIFY_EMAIL=gladiusfinance.org@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

NEXT_PUBLIC_APP_NAME=Monetixa
# Boost promocional (0.40 = +40%). Cámbialo cuando ajustes porcentajes.
NEXT_PUBLIC_PROMO_BOOST=0.40

# Suspender monetización temporal (símbolos o ids, separados por coma).
# Ejemplos: USDT | eth-usdt,bnb-usdt | FLOKI,SHIB
NEXT_PUBLIC_SUSPENDED_TOKENS=bnb-native,bnb-usdt,sol-native,sol-usdt

# Feed de auto-actualización (Hostinger: public_html/monetixa)
UPDATE_FEED_URL=https://sanbustv.io/monetixa

